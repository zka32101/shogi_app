// firestore.rules — Firestore セキュリティルール
// デプロイ方法: firebase deploy --only firestore:rules

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== ユーザー認証チェック =====
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // ===== ゲームログ（プライベート） =====
    match /game_logs/{userId}/logs/{logId} {
      // 自分のログのみ読み書き可能
      allow read, write: if isOwner(userId);
    }

    // ===== ユーザー統計（プライベート） =====
    match /user_stats/{userId} {
      // 自分の統計のみ読み書き可能
      allow read, write: if isOwner(userId);
    }

    // ===== ユーザープロフィール（一部公開） =====
    match /users/{userId} {
      // BAN状態・チート判定・レーティング・勝敗数は Cloud Functions（Admin SDK、
      // Firestoreルールを経由しないため無条件に書き込み可）または admin カスタム
      // クレームを持つ管理者のみが変更できる。isOwner の通常書き込みにこれらを
      // 含めると、本人が自分でBAN解除・チートフラグ消去・レーティング偽装を
      // 行えてしまうため明示的に除外する。
      function protectedUserFields() {
        return ['is_banned', 'banned_at', 'ban_reason', 'cheat_score', 'cheat_flags',
                'flagged_for_review', 'flagged_at', 'rating', 'wins', 'losses',
                'report_count'];
      }

      // 新規プロフィール作成: 保護フィールドは安全な初期値のみ許可（偽装したBAN解除
      // 済み状態・高レーティングでの初期登録を防ぐ）
      allow create: if isOwner(userId) &&
          request.resource.data.get('is_banned', false) == false &&
          request.resource.data.get('rating', 1500) == 1500 &&
          request.resource.data.get('wins', 0) == 0 &&
          request.resource.data.get('losses', 0) == 0 &&
          request.resource.data.get('cheat_score', 0) == 0 &&
          request.resource.data.get('flagged_for_review', false) == false;

      // 本人による更新: 保護フィールドを変更しない場合のみ許可。管理者は無条件で許可
      allow update: if request.auth.token.admin == true ||
          (isOwner(userId) &&
           !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedUserFields()));

      allow delete: if request.auth.token.admin == true;

      // 他のユーザーは読み取りのみ可能
      allow read: if isAuthenticated();
    }

    // ===== ゴースト棋士（公開） =====
    match /ghosts/{userId} {
      // 認証ユーザーは誰でも読み取り可能
      allow read: if isAuthenticated();

      // 自分のゴースト棋士のみ書き込み可能
      allow write: if isOwner(userId);
    }

    // ===== 定跡・戦法（公開） =====
    match /openings/{docId} {
      // すべてのユーザーが読み取り可能
      allow read: if true;

      // 管理者のみ書き込み可能（今後の運用用）
      allow write: if request.auth.token.admin == true;
    }

    // ===== 棋譜コレクション（一部公開） =====
    match /kifu_records/{userId}/records/{kifuId} {
      // 自分の棋譜はすべて読み書き可能
      allow read, write: if isOwner(userId);
    }

    // ===== マッチング・ネットワーク対局（管理者のみ） =====
    match /matches/{matchId} {
      // 対局者のみ読み取り可能
      allow read: if isAuthenticated();

      // システムのみ（Cloud Functions経由で）書き込み可能
      allow write: if false;

      // ── 遅延行為トラッキング（対局相手が観測して記録・cheat_detection_service.dart） ──
      // 以前は isAuthenticated() のみで、対局と無関係な第三者でも任意の対局の証跡を
      // 捏造・改ざんできたため、当該対局の対局者本人のみに書き込みを制限する
      match /tracking/{userId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() &&
            (get(/databases/$(database)/documents/matches/$(matchId)).data.player1_id == request.auth.uid ||
             get(/databases/$(database)/documents/matches/$(matchId)).data.player2_id == request.auth.uid);
      }

      // ── 観戦（spectator_service.dart） ──
      match /spectators/{userId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }

      match /spectator_chat/{msgId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
            request.resource.data.user_id == request.auth.uid;
      }
    }

    // ===== トーナメント（tournament_service.dart・クライアント主導のhonor system） =====
    match /tournaments/{tournamentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ===== クラブ（club_service.dart） =====
    match /clubs/{clubId} {
      allow read: if isAuthenticated();

      // 作成者本人が owner_id として自分を指定した場合のみクラブを作成可能
      allow create: if isAuthenticated() &&
          request.resource.data.owner_id == request.auth.uid;

      // 以前は isAuthenticated() のみで、メンバーでも無い任意のユーザーが他人の
      // クラブの名前・説明・オーナーを書き換えて乗っ取れる状態だったため、
      // オーナー以外は参加/脱退で必要な member_count・member_ids の変更のみ許可する
      allow update: if isAuthenticated() &&
          (resource.data.owner_id == request.auth.uid ||
           request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['member_count', 'member_ids']));

      allow delete: if isAuthenticated() && resource.data.owner_id == request.auth.uid;

      match /members/{memberId} {
        // メンバードキュメントIDは本人のuidのため、本人のみ参加登録・脱退できる
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && memberId == request.auth.uid;
      }
    }

    // ===== フレンド（friend_service.dart） =====
    // 当事者(user1_id/user2_id)本人のみ読み書き可能（他人同士の関係の偽造・削除を防止）
    match /friends/{friendDocId} {
      allow read, delete: if isAuthenticated() &&
          (resource.data.user1_id == request.auth.uid ||
           resource.data.user2_id == request.auth.uid);
      allow create: if isAuthenticated() &&
          (request.resource.data.user1_id == request.auth.uid ||
           request.resource.data.user2_id == request.auth.uid);
    }

    match /friend_requests/{requestId} {
      // 送信者・受信者のみ閲覧可能
      allow read: if isAuthenticated() &&
          (resource.data.sender_id == request.auth.uid ||
           resource.data.recipient_id == request.auth.uid);
      // 作成は申請者本人のみ
      allow create: if isAuthenticated() &&
          request.resource.data.sender_id == request.auth.uid;
      // 承認・却下(statusの更新)は受信者のみ
      allow update: if isAuthenticated() &&
          resource.data.recipient_id == request.auth.uid;
    }

    match /direct_challenges/{challengeId} {
      allow read, write: if isAuthenticated();
    }

    // ===== デイリーチャレンジ（daily_challenge_service.dart） =====
    // 定義データは全員閲覧可能。未生成の日はクライアントが自動生成するため書き込みも必要
    match /daily_challenges/{challengeId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /user_challenge_progress/{progressId} {
      allow read: if isAuthenticated();
      // 自分の進捗のみ書き込み可能（ドキュメントIDは "{uid}_{challengeId}"）
      allow write: if isAuthenticated() &&
          (resource == null || resource.data.user_id == request.auth.uid) &&
          request.resource.data.user_id == request.auth.uid;
    }

    // ===== 非同期対戦・レース対戦（services/async_duel_service.dart） =====
    match /async_duels/{duelId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ===== 不正検出分析（cheat_detection_service.dart） =====
    // 本人は自分の分析結果を閲覧のみ可能（他人には非公開）。
    // 書き込みは isOwner を許可すると本人が自分のチートスコア・フラグを消去・改ざん
    // できてしまうため許可しない。Cloud Functions（Admin SDK）または admin クレーム
    // を持つ管理者のみが書き込み可能
    match /cheat_analysis/{userId} {
      allow read: if isOwner(userId) || request.auth.token.admin == true;
      allow write: if request.auth.token.admin == true;
    }

    // ===== 通知キュー（notification_service.dart / fcm_service.dart） =====
    match /notifications/{notifId} {
      allow read, update, delete: if request.auth.token.admin == true;
      allow create: if isAuthenticated();
    }

    match /fcm_queue/{docId} {
      allow read, update, delete: if request.auth.token.admin == true;
      allow create: if isAuthenticated();
    }

    // ===== 自由将棋テンプレート（free_shogi_service.dart・公開保存分） =====
    match /users/{userId}/free_shogi_templates/{templateId} {
      allow read, write: if isOwner(userId);
    }

    match /matching_queue/{queueId} {
      // 認証ユーザーのみ読み取り可能
      allow read: if isAuthenticated();

      // システムのみ（Cloud Functions経由で）書き込み可能
      allow write: if false;
    }

    // ===== レポート（管理者のみ） =====
    match /reports/{reportId} {
      // 認証ユーザーのみ読み取り可能
      allow read: if isAuthenticated();

      // 認証ユーザーのみ新規作成可能（報告機能）
      allow create: if isAuthenticated() && request.resource.data.reporter_id == request.auth.uid;

      // 管理者のみ更新・削除 可能
      allow update, delete: if request.auth.token.admin == true;
    }

    // ===== バッジ・実績（プライベート） =====
    match /badges/{userId} {
      // 自分のバッジのみ読み書き可能
      allow read, write: if isOwner(userId);
    }

    // ===== デフォルトルール（すべて拒否） =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
