// firestore.rules — Firestore セキュリティルール
// デプロイ方法: firebase deploy --only firestore:rules

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== ユーザー認証チェック =====
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // ===== ゲームログ（プライベート） =====
    match /game_logs/{userId}/logs/{logId} {
      // 自分のログのみ読み書き可能
      allow read, write: if isOwner(userId);
    }

    // ===== ユーザー統計（プライベート） =====
    match /user_stats/{userId} {
      // 自分の統計のみ読み書き可能
      allow read, write: if isOwner(userId);
    }

    // ===== ユーザープロフィール（一部公開） =====
    match /users/{userId} {
      // 認証ユーザーは自分のプロフィールをすべて読み書き可能
      allow read, write: if isOwner(userId);

      // 他のユーザーは公開情報のみ読み取り可能
      allow read: if isAuthenticated();
    }

    // ===== ゴースト棋士（公開） =====
    match /ghosts/{userId} {
      // 認証ユーザーは誰でも読み取り可能
      allow read: if isAuthenticated();

      // 自分のゴースト棋士のみ書き込み可能
      allow write: if isOwner(userId);
    }

    // ===== 定跡・戦法（公開） =====
    match /openings/{docId} {
      // すべてのユーザーが読み取り可能
      allow read: if true;

      // 管理者のみ書き込み可能（今後の運用用）
      allow write: if request.auth.token.admin == true;
    }

    // ===== 棋譜コレクション（一部公開） =====
    match /kifu_records/{userId}/records/{kifuId} {
      // 自分の棋譜はすべて読み書き可能
      allow read, write: if isOwner(userId);
    }

    // ===== マッチング・ネットワーク対局（管理者のみ） =====
    match /matches/{matchId} {
      // 対局者のみ読み取り可能
      allow read: if isAuthenticated();

      // システムのみ（Cloud Functions経由で）書き込み可能
      allow write: if false;
    }

    match /matching_queue/{queueId} {
      // 認証ユーザーのみ読み取り可能
      allow read: if isAuthenticated();

      // システムのみ（Cloud Functions経由で）書き込み可能
      allow write: if false;
    }

    // ===== レポート（管理者のみ） =====
    match /reports/{reportId} {
      // 認証ユーザーのみ読み取り可能
      allow read: if isAuthenticated();

      // 認証ユーザーのみ新規作成可能（報告機能）
      allow create: if isAuthenticated() && request.resource.data.reporter_id == request.auth.uid;

      // 管理者のみ更新・削除 可能
      allow update, delete: if request.auth.token.admin == true;
    }

    // ===== バッジ・実績（プライベート） =====
    match /badges/{userId} {
      // 自分のバッジのみ読み書き可能
      allow read, write: if isOwner(userId);
    }

    // ===== デフォルトルール（すべて拒否） =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
